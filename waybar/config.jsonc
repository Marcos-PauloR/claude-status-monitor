// Trecho para ~/.config/waybar/config.jsonc
// 1. Acrescente "custom/claude" em "modules-right" (ou left/center).
// 2. Cole o bloco abaixo no objeto principal.
"custom/claude": {
    "exec": "~/.local/bin/claude-status-waybar.sh",
    "return-type": "json",
    "restart-interval": 5,
    "format": "✳ {}",
    "tooltip": true,
    // clique: alterna a janela fixada no painel; botão direito: abre a pasta de dados
    "on-click": "~/.local/bin/claude-status-summary.sh --pin-next",
    "on-click-right": "xdg-open ~/.cache/claude-status"
}
